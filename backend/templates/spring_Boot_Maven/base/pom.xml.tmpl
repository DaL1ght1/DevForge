<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>[[ .PackageName ]]</groupId>
    <artifactId>[[ .ServiceName ]]</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>[[ .ServiceName ]]</name>
    <description>[[ xml .Description ]]</description>

    <properties>
        <java.version>[[ .Vars.JAVA_VERSION ]]</java.version>
[[- if or (has "database") (has "messaging") ]]
        <!-- Testcontainers before 1.21.4 cannot talk to Docker Engine 29+. -->
        <testcontainers.version>1.21.4</testcontainers.version>
[[- end ]]
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
[[- range .Dependencies ]]
        <dependency>
            <groupId>[[ .Group ]]</groupId>
            <artifactId>[[ .Artifact ]]</artifactId>
[[- with .Version ]]
            <version>[[ . ]]</version>
[[- end ]]
[[- if eq .Scope "development" ]]
            <scope>runtime</scope>
            <optional>true</optional>
[[- else if .Scope ]]
            <scope>[[ .Scope ]]</scope>
[[- end ]]
        </dependency>
[[- end ]]
[[- if and (has "flyway") (has "postgresql") ]]
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
[[- end ]]
[[- if and (has "flyway") (has "mysql") ]]
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>
[[- end ]]
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>

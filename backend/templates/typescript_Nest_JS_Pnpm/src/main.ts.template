import { NestFactory } from "@nestjs/core"; import { Module, Controller, Get } from "@nestjs/common";
@Controller() class AppController { @Get("api/v1/ping") ping(){ return {service:"{{SERVICE_NAME}}",status:"UP"}; } }
@Module({controllers:[AppController]}) class AppModule {}
async function bootstrap(){ const app=await NestFactory.create(AppModule); await app.listen(8080); } bootstrap();

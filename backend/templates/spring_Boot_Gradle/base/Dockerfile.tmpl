FROM gradle:8-jdk[[ .Vars.JAVA_VERSION ]] AS build
WORKDIR /app
COPY . .
RUN gradle bootJar --no-daemon -x test \
    && cp "$(find build/libs -name '*.jar' ! -name '*-plain.jar' | head -n 1)" /tmp/app.jar

FROM eclipse-temurin:[[ .Vars.JAVA_VERSION ]]-jre
WORKDIR /app
COPY --from=build /tmp/app.jar app.jar
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/app.jar"]